# Copie para .env (chmod 600). Segredo nenhum vai pro git nem pro banco: só aqui.

# Senha do painel. Sem ela o painel não sobe.
ADMIN_PASSWORD=

# Chave(s) das APIs. O painel grava aqui quando você cola uma chave nele.
OPENROUTER_API_KEY=

# Assina desafios e sessões. Se ficar vazio, o servidor cria um na primeira vez e grava aqui.
SERVER_SECRET=

# Onde o app chega (atrás da Cloudflare / do proxy).
HOST=127.0.0.1
PORT=8787

# Painel: só nesta máquina, em outra porta.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788

# De onde vem o IP de quem chama: cloudflare (CF-Connecting-IP), xff (X-Forwarded-For) ou none.
TRUST_PROXY=cloudflare

# Atrás do proxy, recusar o que chegar por http puro (o proxy diz o esquema). 0 desliga.
REQUIRE_HTTPS=1

# Banco e arquivos do servidor.
DATA_DIR=./data
